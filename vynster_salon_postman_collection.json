{
  "info": {
    "name": "Vynster Salon Unified API & Real-Time Sync Collection",
    "description": "Complete Postman collection for testing REST APIs, Authentication, SuperAdmin accounts, Client/Staff databases, and Socket.IO real-time events.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login (Founder / Rooter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rooter1@medhika.com\",\n  \"password\": \"rootadmin1\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify 2FA",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rooter1@medhika.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/verify-2fa",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "verify-2fa"]
            }
          }
        }
      ]
    },
